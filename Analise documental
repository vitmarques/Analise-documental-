  if (
    tipo === "portuguesa" &&
    processosGenealogicosPortugal.includes(processo) &&
    Number(numeroGeracao) === 1
  ) {
    campoArtigo?.classList.remove("hidden");
  }
  if (tipo === "portuguesa") {
    div.querySelector(".same-generation-button")?.classList.add("no-same-generation");

<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Cidadania Alemã PRO</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
<style>
:root {
  --bg-global: #f4f6f8; --bg-container: #ffffff;
  --germany-black: #111827; --germany-red: #DD0000; --germany-gold: #D4AF37;
  --germany-gold-light: rgba(212, 175, 55, 0.1);
  --text-label: #5e6a75; --text-input: #1f2937; --bg-input: #f8f9fa;
  --border-radius-main: 16px; --border-radius-input: 12px;
}
* { box-sizing: border-box; }
body { font-family: 'Montserrat', sans-serif; margin: 0; background-color: var(--bg-global); color: var(--text-input); padding: 40px 20px; -webkit-font-smoothing: antialiased; }
.container { max-width: 950px; margin: 0 auto; background: var(--bg-container); padding: 40px; border-radius: var(--border-radius-main); box-shadow: 0 10px 30px rgba(0,0,0,.03); }
header { font-size: 26px; font-weight: 700; color: var(--germany-black); margin-bottom: 35px; border-bottom: 2px solid #f0f2f5; padding-bottom: 20px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.logo-badge { background: var(--germany-gold-light); color: #b38f1d; border: 1px solid rgba(212,175,55,.3); font-size: 12px; padding: 6px 16px; border-radius: 20px; font-weight: 700; letter-spacing: .5px; white-space: nowrap; }
h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--germany-red); margin-top: 0; margin-bottom: 25px; font-weight: 700; }
.card { border: 1px solid #eef0f3; padding: 25px; border-radius: var(--border-radius-main); margin-bottom: 25px; background: #fff; box-shadow: 0 4px 12px rgba(0,0,0,.01); }
.title { font-weight: 700; font-size: 15px; margin-bottom: 20px; color: var(--germany-black); display: flex; align-items: center; gap: 8px; }
.title::before { content: ''; display: inline-block; width: 4px; height: 16px; background: var(--germany-red); border-radius: 2px; flex-shrink: 0; }
.row { display: flex; gap: 20px; margin-bottom: 20px; align-items: center; }
.row:last-of-type { margin-bottom: 0; }
input, select { flex: 1; min-width: 0; padding: 14px 18px; border-radius: var(--border-radius-input); border: 1px solid #e2e8f0; background-color: var(--bg-input); color: var(--text-input); font-family: inherit; font-size: 14px; font-weight: 500; height: 52px; transition: all .2s ease; }
input:focus, select:focus { outline: none; border-color: var(--germany-black); background-color: #fff; box-shadow: 0 0 0 4px rgba(17,24,39,.05); }
input::placeholder { color: #a0aec0; }
.small { flex: .6; }
.checkbox-container { display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 13px; color: var(--text-label); cursor: pointer; user-select: none; background: var(--bg-input); padding: 0 20px; border-radius: var(--border-radius-input); min-height: 52px; border: 1px solid #e2e8f0; flex: 1; transition: background .2s; }
.checkbox-container:hover { background: #edf2f7; }
.checkbox-container input { flex: none; width: 18px; height: 18px; cursor: pointer; margin: 0; }
button { background: var(--germany-black); color: #fff; border: none; padding: 14px 24px; border-radius: var(--border-radius-input); cursor: pointer; font-weight: 600; font-size: 14px; font-family: inherit; transition: all .2s; }
button:hover { background: #000; transform: translateY(-1px); }
.btn-add { background: #fff; color: var(--germany-black); border: 2px dashed #e2e8f0; width: 100%; padding: 16px; border-radius: var(--border-radius-input); font-weight: 600; }
.btn-add:hover { background: var(--bg-input); border-color: var(--germany-gold); color: var(--germany-black); transform: none; }
.remove { background: #fff5f5; color: #e53e3e; border: 1px solid #fed7d7; margin-top: 10px; padding: 10px 18px; font-size: 13px; }
.remove:hover { background: #fed7d7; color: #9b2c2c; transform: none; }
.footer { text-align: center; margin-top: 40px; border-top: 2px solid #f0f2f5; padding-top: 30px; }
.btn-submit { background: var(--germany-red); font-size: 16px; padding: 18px 45px; border-radius: var(--border-radius-input); letter-spacing: .5px; box-shadow: 0 4px 15px rgba(221,0,0,.2); }
.btn-submit:hover { background: #b90000; box-shadow: 0 6px 20px rgba(221,0,0,.3); }
.hidden { display: none !important; }
.selector-processo { border: 1px solid #eef0f3; padding: 25px; border-radius: var(--border-radius-main); margin-bottom: 25px; background: #fff; }
.selector-processo .row { align-items: stretch; }
.selector-processo label { display: block; font-size: 12px; font-weight: 700; color: var(--text-label); margin-bottom: 8px; }
.selector-processo select { width: 100%; }
.portugal-extra { margin: 15px 0 20px; padding: 20px; background: #fbfcfd; border: 1px solid #e6eaf0; border-radius: var(--border-radius-input); }
.portugal-extra .row { margin-bottom: 14px; }
.portugal-extra .row:last-child { margin-bottom: 0; }
.portugal-extra .field-label { display: block; font-size: 13px; font-weight: 700; color: var(--text-label); margin-bottom: 10px; }
.portugal-extra .radio-wrap { display: flex; gap: 18px; flex-wrap: wrap; }
.portugal-extra .radio-wrap label { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; }
.portugal-extra .radio-wrap input { flex: none; width: 17px; height: 17px; }
.portugal-extra input[type="radio"] { height: auto; }
.portugal-doc-card { border: 1px solid #eef0f3; padding: 25px; border-radius: var(--border-radius-main); margin-bottom: 20px; background: #fff; }
.portugal-doc-card .doc-title { font-weight: 700; font-size: 15px; margin-bottom: 18px; color: var(--germany-black); }
.portugal-doc-card .doc-title::before { content: ''; display: inline-block; width: 4px; height: 16px; margin-right: 8px; background: var(--germany-red); border-radius: 2px; vertical-align: middle; }
.no-same-generation { display: none !important; }
.doc-section { background: #f8f9fa; padding: 20px; border-radius: var(--border-radius-input); border: 1px dashed #cbd5e0; margin-top: 15px; }
.divergencia-section { margin-top: 25px; padding: 22px; border: 1px solid #e6eaf0; border-radius: var(--border-radius-input); background: #fbfcfd; }
.divergencia-heading { font-size: 13px; font-weight: 700; color: var(--germany-black); margin: 0 0 15px; text-transform: uppercase; letter-spacing: .6px; }
.divergencia-opcoes { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 15px; }
.divergencia-opcao { flex: 1; min-width: 220px; display: flex; align-items: center; gap: 10px; padding: 13px 15px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--text-label); }
.divergencia-opcao input { flex: none; width: 17px; height: 17px; margin: 0; }
.divergencia-item { border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; margin-top: 14px; background: #fff; }
.divergencia-item-titulo { font-size: 13px; font-weight: 700; margin-bottom: 15px; color: var(--germany-black); }
.divergencia-item .row { margin-bottom: 12px; }
.divergencia-item .row:last-of-type { margin-bottom: 0; }
.divergencia-item input { background: #fbfcfd; }
.btn-add-divergencia { width: 100%; margin-top: 14px; background: #fff; color: var(--germany-black); border: 1px dashed #cbd5e0; }
.btn-add-divergencia:hover { background: #f8f9fa; border-color: var(--germany-gold); transform: none; }
@media (max-width: 700px) {
 body { padding: 15px 10px; } .container { padding: 22px 16px; }
 header { font-size: 20px; align-items: flex-start; flex-direction: column; }
 .card { padding: 18px 14px; } .row { flex-direction: column; gap: 10px; align-items: stretch; margin-bottom: 12px; }
 .row input, .row select, .row .checkbox-container { width: 100%; flex: auto; }
 .divergencia-section { padding: 15px; }
}
</style>
</head>
<body>
<div class="container">
  <header> Análise documental <div class="logo-badge">Cidadania4u</div></header>
  <section class="selector-processo">
    <h2>Identificação do processo</h2>
    <div class="row">
      <div style="flex:1; min-width:0">
        <label for="tipo-cidadania">Tipo de cidadania</label>
        <select id="tipo-cidadania" onchange="alterarTipoCidadania()">
          <option value="">Selecione</option>
          <option value="alema">Alemanha</option>
          <option value="portuguesa">Portugal</option>
        </select>
      </div>
      <div id="campo-tipo-processo" class="hidden" style="flex:1; min-width:0">
        <label for="tipo-processo-portugues">Tipo de processo português</label>
        <select id="tipo-processo-portugues" onchange="alterarProcessoPortugues()">
          <option value="">Selecione</option>
          <option value="netos-maiores">Neto Maior</option>
          <option value="netos-menores">Neto Menor</option>
          <option value="filho-maior">Filho Maior</option>
          <option value="filho-menor">Filho Menor</option>
          <option value="casamento">Processo por Casamento</option>
          <option value="transcricao">Transcrição de Casamento</option>
          <option value="homologacao">Homologação de Divórcio</option>
        </select>
      </div>
    </div>
  </section>

  <div class="box hidden" id="box-genealogia">
    <h2 id="titulo-genealogia">Árvore Genealógica (Gerações)</h2>
    <div id="geracoes"></div>
    <button class="btn-add" id="btn-add-geracao" onclick="addGeracao()">+ Adicionar Geração</button>
  </div>

  <section id="portugal-documentos" class="hidden">
    <div class="card">
      <div class="title">Dados do processo</div>
      <div id="campos-processo-portugues"></div>
    </div>
    <div id="lista-documentos-portugueses"></div>
    <button class="btn-add" type="button" onclick="adicionarDocumentoPortugues()">+ Adicionar documento</button>
  </section>

  <div class="footer"><button class="btn-submit" onclick="gerarPDF()">GERAR PDF</button></div>
</div>
<script>
const parentesco = { 1: "Português", 2: "Filho(a)", 3: "Neto(a)", 4: "Bisneto(a)", 5: "Trineto(a)" };
let proximoIdDivergencia = 1;
let proximoIdDocumentoPortugal = 1;

const processosGenealogicosPortugal = ["netos-maiores", "netos-menores", "filho-maior", "filho-menor"];
const processosComResidenciaPortugal = ["netos-maiores", "netos-menores", "casamento"];

function alterarTipoCidadania() {
  const tipo = document.getElementById("tipo-cidadania").value;
  const campoProcesso = document.getElementById("campo-tipo-processo");
  campoProcesso.classList.toggle("hidden", tipo !== "portuguesa");
  document.getElementById("tipo-processo-portugues").value = "";
  document.getElementById("portugal-documentos").classList.add("hidden");
  document.getElementById("box-genealogia").classList.toggle("hidden", tipo === "" || (tipo === "portuguesa"));
  document.getElementById("titulo-genealogia").textContent = "Árvore Genealógica (Gerações)";
  document.getElementById("btn-add-geracao").textContent = "+ Adicionar Geração";
  document.getElementById("geracoes").innerHTML = "";
  if (tipo === "alema") {
    criarPessoa(1);
  }
}

function alterarProcessoPortugues() {
  const processo = document.getElementById("tipo-processo-portugues").value;
  const genealogico = processosGenealogicosPortugal.includes(processo);
  const documental = ["casamento", "transcricao", "homologacao"].includes(processo);
  const box = document.getElementById("box-genealogia");
  const docs = document.getElementById("portugal-documentos");

  box.classList.toggle("hidden", !genealogico);
  docs.classList.toggle("hidden", !documental);

  document.getElementById("titulo-genealogia").textContent = "Linha Familiar";
  document.getElementById("btn-add-geracao").textContent = "+ Adicionar pessoa / geração";
  document.getElementById("geracoes").innerHTML = "";

  if (genealogico) {
    criarPessoa(1);
    document.querySelectorAll(".same-generation-button").forEach(btn => btn.classList.add("no-same-generation"));
  }

  document.querySelectorAll(".campos-casamento-portugal").forEach(el => {
    const cartao = el.closest(".card");
    const estadoCivil = cartao?.querySelector(".casamento-status")?.value;
    el.classList.toggle("hidden", !(processo === "casamento" && estadoCivil === "casado"));
  });

  if (documental) montarCamposProcessoPortugal(processo);
  else {
    document.getElementById("campos-processo-portugues").innerHTML = "";
    document.getElementById("lista-documentos-portugueses").innerHTML = "";
  }
}

function togglePaisResidencia(mostrar) {
  const wrap = document.getElementById("pais-residencia-wrap");
  wrap.classList.toggle("hidden", !mostrar);
  if (!mostrar) document.getElementById("pais-residencia").value = "";
}

function togglePaisResidenciaPortugal(radio, mostrar) {
  const bloco = radio.closest(".pt-residencia-requerente");
  const wrap = bloco?.querySelector(".pt-pais-residencia-wrap");
  wrap?.classList.toggle("hidden", !mostrar);
  if (!mostrar) {
    const pais = bloco?.querySelector(".pt-pais-residencia");
    if (pais) pais.value = "";
  }
}

function toggleRequerentePortugalDocumental(checkbox) {
  const campos = checkbox.closest("#campos-processo-portugues");
  const idade = campos?.querySelector(".pt-idade");
  const residencia = campos?.querySelector(".pt-residencia-requerente");
  const processo = document.getElementById("tipo-processo-portugues").value;
  if (idade) idade.classList.toggle("hidden", !checkbox.checked);
  if (residencia) residencia.classList.toggle("hidden", !(checkbox.checked && processo === "casamento"));
  if (!checkbox.checked && residencia) {
    residencia.querySelectorAll('input[type="radio"]').forEach(r => r.checked = false);
    residencia.querySelector(".pt-pais-residencia-wrap")?.classList.add("hidden");
    const pais = residencia.querySelector(".pt-pais-residencia");
    if (pais) pais.value = "";
  }
}

function campoPortugal(rotulo, classe, tipo = "text", placeholder = "") {
  return `<div class="row"><input type="${tipo}" class="${classe}" placeholder="${rotulo}" aria-label="${rotulo}" ${placeholder ? `title="${placeholder}"` : ""}></div>`;
}

function montarCamposProcessoPortugal(processo) {
  const campos = document.getElementById("campos-processo-portugues");
  const lista = document.getElementById("lista-documentos-portugueses");
  campos.innerHTML = "";
  lista.innerHTML = "";
  proximoIdDocumentoPortugal = 1;

  if (processo === "casamento") {
    campos.innerHTML = `
      <div class="title">Dados do requerente</div>
      <div class="row"><input class="pt-requerente" placeholder="Nome completo do requerente"><input class="pt-idade" type="number" min="0" placeholder="Idade do requerente"></div>
      <div class="pt-residencia-requerente portugal-extra">
        <div class="field-label">O requerente já residiu fora do Brasil?</div>
        <div class="radio-wrap">
          <label><input type="radio" name="pt-cliente-residiu-fora" value="Não" onchange="togglePaisResidenciaPortugal(this, false)"> Não</label>
          <label><input type="radio" name="pt-cliente-residiu-fora" value="Sim" onchange="togglePaisResidenciaPortugal(this, true)"> Sim</label>
        </div>
        <div class="row pt-pais-residencia-wrap hidden" style="margin-top:14px"><input class="pt-pais-residencia" placeholder="Em qual país?" aria-label="País em que o requerente residiu"></div>
      </div>
      <div class="title" style="margin-top:22px">Dados do cônjuge</div>
      <div class="row"><input class="pt-conjuge" placeholder="Nome completo do cônjuge"><input class="pt-profissao" placeholder="Profissão do cônjuge"></div>
      <div class="row"><input class="pt-nascimento-conjuge" type="date" aria-label="Data de nascimento do cônjuge"><input class="pt-nacionalidade-conjuge" placeholder="Nacionalidade do cônjuge"></div>
      <div class="title" style="margin-top:22px">Dados do casamento</div>
      <div class="row"><input class="pt-data-casamento" type="date" aria-label="Data do casamento"><input class="pt-tempo-casados" type="number" min="0" placeholder="Tempo de casados (anos)"></div>
      <div class="row"><input class="pt-regime" placeholder="Regime de bens"><input class="pt-local-casamento" placeholder="Local do casamento"></div>`;
    adicionarDocumentoPortugues("Assento de nascimento do português");
    adicionarDocumentoPortugues("Certidão de casamento portuguesa");
    adicionarDocumentoPortugues("Certidão de nascimento do cônjuge");
  } else if (processo === "transcricao") {
    campos.innerHTML = `
      <div class="title">Dados dos cônjuges</div>
      <div class="row"><input class="pt-conjuge-1" placeholder="Nome completo do primeiro cônjuge"><input class="pt-nascimento-1" type="date" aria-label="Data de nascimento do primeiro cônjuge"></div>
      <div class="row"><input class="pt-nacionalidade-1" placeholder="Nacionalidade do primeiro cônjuge"><input class="pt-conjuge-2" placeholder="Nome completo do segundo cônjuge"></div>
      <div class="row"><input class="pt-nascimento-2" type="date" aria-label="Data de nascimento do segundo cônjuge"><input class="pt-nacionalidade-2" placeholder="Nacionalidade do segundo cônjuge"></div>
      <div class="title" style="margin-top:22px">Dados do requerente</div>
      <div class="row"><input class="pt-requerente-transcricao" placeholder="Nome completo do requerente"><input class="pt-idade" type="number" min="0" placeholder="Idade do requerente"></div>
      <div class="title" style="margin-top:22px">Dados do casamento</div>
      <div class="row"><input class="pt-data-casamento" type="date" aria-label="Data do casamento"><input class="pt-local-casamento" placeholder="Local do casamento"></div>
      <div class="row"><input class="pt-regime" placeholder="Regime de bens"></div>`;
    adicionarDocumentoPortugues("Assento de nascimento do cônjuge português");
    adicionarDocumentoPortugues("Certidão brasileira de casamento");
    adicionarDocumentoPortugues("Certidão de nascimento do outro cônjuge");
  } else {
    campos.innerHTML = `
      <div class="title">Dados das partes</div>
      <div class="row"><input class="pt-requerente" placeholder="Nome completo do requerente"><input class="pt-idade" type="number" min="0" placeholder="Idade do requerente"></div>
      <div class="row"><input class="pt-conjuge" placeholder="Nome completo do ex-cônjuge"><input class="pt-data-casamento" type="date" aria-label="Data do casamento"></div>
      <div class="title" style="margin-top:22px">Dados do casamento e do divórcio</div>
      <div class="row"><input class="pt-local-casamento" placeholder="Local do casamento"><input class="pt-regime" placeholder="Regime de bens"></div>
      <div class="row"><input class="pt-data-divorcio" type="date" aria-label="Data do divórcio"><input class="pt-pais-divorcio" placeholder="País em que ocorreu o divórcio"></div>
      <div class="portugal-extra">
        <div class="field-label">Possuímos a sentença de divórcio e o trânsito em julgado?</div>
        <div class="radio-wrap">
          <label><input type="radio" name="pt-sentenca-transito" value="Sim"> Sim</label>
          <label><input type="radio" name="pt-sentenca-transito" value="Não"> Não</label>
        </div>
      </div>
      <div class="row"><input class="pt-profissao" placeholder="Profissão do requerente"><input class="pt-tempo-casados" type="number" min="0" placeholder="Tempo de casamento (anos)"></div>`;
    adicionarDocumentoPortugues("Certidão de casamento");
    adicionarDocumentoPortugues("Documentos do divórcio");
  }
}

function adicionarDocumentoPortugues(nomeInicial = "") {
  const lista = document.getElementById("lista-documentos-portugueses");
  const id = proximoIdDocumentoPortugal++;
  const card = document.createElement("div");
  card.className = "portugal-doc-card card";
  card.dataset.documentoPortugal = id;
  card.innerHTML = `
    <div class="doc-title">Documento ${id}</div>
    <div class="row"><input class="pt-documento-nome" placeholder="Nome do documento" value="${nomeInicial.replace(/&/g,"&amp;").replace(/"/g,"&quot;")}"></div>
    <div class="row"><input class="pt-documento-pessoa" placeholder="Pessoa a que o documento pertence"><input class="pt-documento-emissao" placeholder="País / local de emissão"></div>
    <label class="checkbox-container"><input type="checkbox" class="pt-documento-requerente"> Esta pessoa é o requerente do processo?</label>
    <section class="divergencia-section">
      <div class="divergencia-heading">Análise Documental – Divergências Identificadas</div>
      <div class="divergencia-opcoes">
        <label class="divergencia-opcao"><input type="radio" class="divergencia-status" name="pt-doc-div-${id}" value="nao" checked onchange="toggleDivergencias(this)"> Não foram identificadas divergências</label>
        <label class="divergencia-opcao"><input type="radio" class="divergencia-status" name="pt-doc-div-${id}" value="sim" onchange="toggleDivergencias(this)"> Foram identificadas divergências</label>
      </div>
      <div class="divergencias-detalhes hidden"><div class="divergencias-lista"></div><button type="button" class="btn-add-divergencia" onclick="adicionarDivergencia(this)">+ Adicionar divergência</button></div>
    </section>
    <div class="row" style="margin-top:15px"><input class="pt-documento-observacoes" placeholder="Observações sobre o documento"></div>
    <button class="remove" type="button" onclick="this.closest('.portugal-doc-card').remove()">Remover documento</button>`;
  lista.appendChild(card);
}

function atualizarTitulos() {
  document.querySelectorAll("#geracoes .card").forEach((card) => {
    const numeroGeracao = Number(card.dataset.geracao) || 1;
    const subGeracao = card.dataset.subgeracao || "";
    const parentescoTexto = parentesco[numeroGeracao] || "Descendente";
    const identificacaoGeracao = subGeracao ? `${numeroGeracao}.${subGeracao}` : `${numeroGeracao}`;
    card.querySelector(".title").innerText = `Geração ${identificacaoGeracao} - ${parentescoTexto}`;
    card.dataset.parentesco = parentescoTexto;
  });
}

function removerGeracao(btn) {
  btn.closest(".card").remove();
  atualizarTitulos();
}

function toggleCasamento(selectElement) {
  const card = selectElement.closest(".card");
  const dataInput = card.querySelector(".casamento-data");
  const conjugeInput = card.querySelector(".conjuge-nome");
  if (selectElement.value === "casado") {
    dataInput.classList.remove("hidden");
    conjugeInput.classList.remove("hidden");
    const camposPortugal = card.querySelector(".campos-casamento-portugal");
    if (camposPortugal && document.getElementById("tipo-cidadania").value === "portuguesa" && document.getElementById("tipo-processo-portugues").value === "casamento") camposPortugal.classList.remove("hidden");
  } else {
    dataInput.classList.add("hidden");
    conjugeInput.classList.add("hidden");
    dataInput.value = "";
    conjugeInput.value = "";
    const camposPortugal = card.querySelector(".campos-casamento-portugal");
    if (camposPortugal) camposPortugal.classList.add("hidden");
  }
}

function toggleResidenciaRequerente(radio, mostrar) {
  const bloco = radio.closest(".residencia-requerente");
  bloco?.querySelector(".pais-residencia-requerente")?.classList.toggle("hidden", !mostrar);
  if (!mostrar) {
    const pais = bloco?.querySelector(".pais-residencia-valor");
    if (pais) pais.value = "";
  }
}

function toggleRequerente(checkboxElement) {
  const docSection = checkboxElement.closest(".card").querySelector(".doc-section");
  if (checkboxElement.checked) {
    docSection.classList.remove("hidden");
    const idade = checkboxElement.closest(".card").querySelector(".idade-requerente");
    if (idade) idade.classList.remove("hidden");
    const residencia = checkboxElement.closest(".card").querySelector(".residencia-requerente");
    const processo = document.getElementById("tipo-processo-portugues").value;
    if (residencia) residencia.classList.toggle("hidden", !(document.getElementById("tipo-cidadania").value === "portuguesa" && processosComResidenciaPortugal.includes(processo)));
    const representante = checkboxElement.closest(".card").querySelector(".dados-representante-menor");
    if (representante) representante.classList.toggle("hidden", !(document.getElementById("tipo-cidadania").value === "portuguesa" && ["netos-menores", "filho-menor"].includes(processo)));
  } else {
    docSection.classList.add("hidden");
    const idade = checkboxElement.closest(".card").querySelector(".idade-requerente-valor");
    if (idade) idade.value = "";
    const representante = checkboxElement.closest(".card").querySelector(".dados-representante-menor");
    if (representante) {
      representante.classList.add("hidden");
      representante.querySelectorAll("input, select").forEach(el => el.value = "");
    }
    const residencia = checkboxElement.closest(".card").querySelector(".residencia-requerente");
    if (residencia) {
      residencia.classList.add("hidden");
      residencia.querySelectorAll('input[type="radio"]').forEach(r => r.checked = false);
      residencia.querySelector(".pais-residencia-requerente")?.classList.add("hidden");
      const pais = residencia.querySelector(".pais-residencia-valor");
      if (pais) pais.value = "";
    }
    docSection.querySelector(".doc-tipo").value = "RG";
    docSection.querySelector(".doc-num").value = "";
    docSection.querySelector(".doc-validade").value = "";
  }
}

function toggleDivergencias(radioElement) {
  const card = radioElement.closest(".card");
  const detalhes = card.querySelector(".divergencias-detalhes");
  if (radioElement.value === "sim") {
    detalhes.classList.remove("hidden");
    if (!detalhes.querySelector(".divergencia-item")) adicionarDivergencia(card.querySelector(".btn-add-divergencia"));
  } else {
    detalhes.classList.add("hidden");
  }
}

function adicionarDivergencia(btn) {
  const card = btn.closest(".card");
  const lista = card.querySelector(".divergencias-lista");
  const numero = lista.querySelectorAll(".divergencia-item").length + 1;
  const id = proximoIdDivergencia++;
  const item = document.createElement("div");
  item.className = "divergencia-item";
  item.dataset.divergenciaId = id;
  item.innerHTML = `
<div class="divergencia-item-titulo">Divergência <span class="numero-divergencia">${numero}</span></div>
<div class="row">
  <input class="divergencia-documento" placeholder="Documento (ex.: Certidão de nascimento)" aria-label="Documento da divergência">
</div>
<div class="row">
  <input class="divergencia-dado" placeholder="Qual dado está errado?" aria-label="Qual dado está errado?">
</div>
<div class="row">
  <input class="divergencia-consta" placeholder="Como consta no documento" aria-label="Como consta no documento">
  <input class="divergencia-deveria" placeholder="Como deveria constar" aria-label="Como deveria constar">
</div>
<button type="button" class="remove" onclick="removerDivergencia(this)">Remover divergência</button>`;
lista.appendChild(item);
atualizarNumerosDivergencias(card);
}

function removerDivergencia(btn) {
  const card = btn.closest(".card");
  btn.closest(".divergencia-item").remove();
  atualizarNumerosDivergencias(card);
  if (!card.querySelector(".divergencias-lista .divergencia-item")) {
    const radioSim = card.querySelector('.divergencia-status[value="sim"]');
    if (radioSim.checked) adicionarDivergencia(card.querySelector(".btn-add-divergencia"));
  }
}

function atualizarNumerosDivergencias(card) {
  card.querySelectorAll(".divergencia-item").forEach((item, index) => {
    item.querySelector(".numero-divergencia").textContent = index + 1;
  });
}

function proximaGeracao() {
  let maior = 0;
  document.querySelectorAll("#geracoes .card").forEach(card => {
    maior = Math.max(maior, Number(card.dataset.geracao) || 0);
  });
  return maior + 1;
}

function criarPessoa(numeroGeracao, subGeracao = null) {
  const div = document.createElement("div");
  div.className = "card";
  div.dataset.geracao = numeroGeracao;
  div.dataset.subgeracao = subGeracao || "";
  div.innerHTML = `
    <div class="title"></div>
    <div class="row">
      <input placeholder="Nome completo" class="nome">
      <input placeholder="Data nascimento" class="nasc small">
    </div>
    <div class="row campo-artigo-portugues hidden">
      <input placeholder="Artigo pelo qual o português foi reconhecido português" class="artigo-reconhecimento" aria-label="Artigo pelo qual o português foi reconhecido português">
    </div>
    <div class="row">
      <input placeholder="País de nascimento" class="nasc-pais">
      <input placeholder="Estado de nascimento" class="nasc-estado">
      <input placeholder="Cidade de nascimento" class="nasc-cidade">
    </div>
    <div class="row">
      <select onchange="toggleCasamento(this)" class="casamento-status">
        <option value="solteiro">Solteiro(a)</option>
        <option value="divorciado">Divorciado(a)</option>
        <option value="casado">Casado(a)</option>
        <option value="não consta">Não consta</option>
      </select>
      <input placeholder="Nome do cônjuge" class="conjuge-nome hidden">
      <input placeholder="Data casamento" class="casamento-data hidden">
      <label class="checkbox-container"><input type="checkbox" class="is-requerente" onchange="toggleRequerente(this)"> É Requerente?</label>
    </div>
    <div class="doc-section hidden">
      <div class="row idade-requerente hidden">
        <input type="number" min="0" placeholder="Idade do requerente" class="idade-requerente-valor">
      </div>
      <div class="residencia-requerente portugal-extra hidden">
        <div class="field-label">O requerente já residiu fora do Brasil?</div>
        <div class="radio-wrap">
          <label><input type="radio" class="residiu-fora" value="Não" onchange="toggleResidenciaRequerente(this, false)"> Não</label>
          <label><input type="radio" class="residiu-fora" value="Sim" onchange="toggleResidenciaRequerente(this, true)"> Sim</label>
        </div>
        <div class="row pais-residencia-requerente hidden" style="margin-top:14px"><input class="pais-residencia-valor" placeholder="Em qual país?" aria-label="País em que o requerente residiu"></div>
      </div>
      <div class="row">
        <select class="doc-tipo"><option value="RG">RG</option><option value="Passaporte">Passaporte</option><option value="CNH">CNH</option></select>
        <input placeholder="Número do Documento" class="doc-num">
        <input placeholder="Validade do Doc." class="doc-validade small">
      </div>
      <div class="portugal-extra hidden dados-representante-menor">
        <div class="field-label">Documento do pai/mãe ou representante legal</div>
        <div class="row"><input class="representante-nome" placeholder="Nome do pai/mãe ou representante legal"></div>
        <div class="row">
          <select class="representante-doc-tipo"><option value="">Tipo de documento do representante</option><option value="RG">RG</option><option value="Passaporte">Passaporte</option><option value="CNH">CNH</option><option value="Outro">Outro</option></select>
          <input class="representante-doc-num" placeholder="Número do documento do representante">
          <input type="date" class="representante-doc-validade small" aria-label="Validade do documento do representante">
        </div>
      </div>
    </div>
    <div class="portugal-extra hidden campos-casamento-portugal">
      <div class="row">
        <input type="number" min="0" placeholder="Tempo de casados (anos)" class="tempo-casados">
        <input placeholder="Profissão do cônjuge" class="profissao-conjuge">
      </div>
    </div>

    <section class="divergencia-section">
      <div class="divergencia-heading">Análise Documental – Divergências Identificadas</div>
      <div class="divergencia-opcoes">
        <label class="divergencia-opcao"><input type="radio" class="divergencia-status" name="divergencia-${proximoIdDivergencia}" value="nao" checked onchange="toggleDivergencias(this)"> Não foram identificadas divergências</label>
        <label class="divergencia-opcao"><input type="radio" class="divergencia-status" name="divergencia-${proximoIdDivergencia}" value="sim" onchange="toggleDivergencias(this)"> Foram identificadas divergências</label>
      </div>
      <div class="divergencias-detalhes hidden">
        <div class="divergencias-lista"></div>
        <button type="button" class="btn-add-divergencia" onclick="adicionarDivergencia(this)">+ Adicionar divergência</button>
      </div>
    </section>

    <div class="row" style="margin-top:20px">
      <button class="btn-add same-generation-button" onclick="adicionarMesmaGeracao(this)">+ Adicionar pessoa na mesma geração</button>

  // Garante que cada grupo de opções de rádio seja exclusivo por pessoa.
  const radioName = `divergencia-pessoa-${Date.now()}-${Math.random().toString(36).slice(2)}`;
  div.querySelectorAll(".divergencia-status").forEach(radio => radio.name = radioName);
  div.querySelectorAll(".residiu-fora").forEach(radio => radio.name = `residiu-fora-${radioName}`);
  document.getElementById("geracoes").appendChild(div);
  const tipo = document.getElementById("tipo-cidadania")?.value;

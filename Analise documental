function addGeracao() { criarPessoa(proximaGeracao()); }

function adicionarMesmaGeracao(btn) {
  const cardAtual = btn.closest(".card");
  const numeroGeracao = Number(cardAtual.dataset.geracao);
  const pessoasMesmaGeracao = document.querySelectorAll(`#geracoes .card[data-geracao="${numeroGeracao}"]`).length;
  criarPessoa(numeroGeracao, pessoasMesmaGeracao);
}

function coletarCamposPortugal(container) {
  const resultado = [];
  container.querySelectorAll("input, select, textarea").forEach(el => {
    if (el.type === "radio" && !el.checked) return;
    if (el.type === "checkbox" && !el.checked) return;
    let rotulo = el.getAttribute("placeholder") || el.getAttribute("aria-label") || el.name || "Informação";
    if (el.classList.contains("pt-documento-requerente")) rotulo = "A pessoa deste documento é o requerente?";
    if (el.type === "radio" && el.name === "pt-requerente-conjuge") rotulo = "O requerente é um dos cônjuges?";
    if (el.type === "radio" && el.name === "pt-sentenca-transito") rotulo = "Possuímos a sentença de divórcio e o trânsito em julgado?";
    const v = el.type === "checkbox" ? "Sim" : (el.value || "");
    if (String(v).trim()) resultado.push([rotulo, v]);
  });
  return resultado;
}

function adicionarDivergenciasDocumentoPDF(pdf, card, margemEsquerda) {
  let yLocal = pdf.lastAutoTable ? pdf.lastAutoTable.finalY + 5 : 40;
  const status = card.querySelector(".divergencia-status:checked")?.value || "nao";
  pdf.setFont("helvetica", "bold"); pdf.setFontSize(10); pdf.setTextColor(17,24,37);
  if (yLocal > 265) { pdf.addPage(); yLocal = 20; }
  pdf.text("Análise Documental – Divergências Identificadas", margemEsquerda, yLocal);
  yLocal += 6;
  if (status === "nao") {
    pdf.setFont("helvetica", "normal"); pdf.setFontSize(9.5);
    pdf.text("Não foram identificadas divergências documentais.", margemEsquerda, yLocal);
    return yLocal + 8;
  }
  const itens = Array.from(card.querySelectorAll(".divergencia-item"));
  if (!itens.length) {
    pdf.setFont("helvetica", "normal"); pdf.setFontSize(9.5);
    pdf.text("Foram identificadas divergências, mas nenhum detalhe foi preenchido.", margemEsquerda, yLocal);
    return yLocal + 8;
  }
  itens.forEach((item, index) => {
    pdf.autoTable({
      startY: yLocal, head: [],
      body: [
        [`Divergência ${index + 1} — Documento`, item.querySelector(".divergencia-documento")?.value.trim() || "Não informado"],
        ["Como consta no documento", item.querySelector(".divergencia-consta")?.value.trim() || "Não informado"],
        ["Como deveria constar", item.querySelector(".divergencia-deveria")?.value.trim() || "Não informado"]
      ],
      theme: "grid",
      styles: { font: "helvetica", fontSize: 9, cellPadding: 3.2, overflow: "linebreak", textColor: [60,65,75], lineColor: [225,230,235], lineWidth: 0.2, valign: "top" },
      columnStyles: { 0: { cellWidth: 55, fontStyle: "bold", fillColor: [248,249,250], textColor: [80,90,100] }, 1: { cellWidth: "auto" } },
      margin: { left: margemEsquerda, right: 14, bottom: 18 }, pageBreak: "auto", rowPageBreak: "avoid"
    });
    yLocal = pdf.lastAutoTable.finalY + 4;
  });
  return yLocal + 5;
}

function gerarPDF() {
  if (!window.jspdf || !window.jspdf.jsPDF) {
    alert("Não foi possível carregar a biblioteca do PDF. Verifique sua conexão com a internet e tente novamente.");
    return;
  }
  const { jsPDF } = window.jspdf;
  const pdf = new jsPDF('p', 'mm', 'a4');
  const margemEsquerda = 14;
  const larguraUtil = 182;
  const tipoCidadania = document.getElementById("tipo-cidadania").value;
  const processoPortugal = document.getElementById("tipo-processo-portugues").value;
  if (!tipoCidadania) { alert("Selecione o tipo de cidadania antes de gerar o PDF."); return; }
  if (tipoCidadania === "portuguesa" && !processoPortugal) { alert("Selecione o tipo de processo português antes de gerar o PDF."); return; }

  if (tipoCidadania === "portuguesa" && ["casamento", "transcricao", "homologacao"].includes(processoPortugal)) {
    let yPt = 36;
    pdf.setTextColor(17,24,37); pdf.setFontSize(14); pdf.setFont("helvetica","bold");
    pdf.text("EXTRATO DA REVISÃO DO PROCESSO DE CIDADANIA", 14, 16);
    pdf.setFillColor(17,24,37); pdf.rect(14,20,15,.8,"F");
    pdf.setFillColor(221,0,0); pdf.rect(29,20,15,.8,"F");
    pdf.setFillColor(212,175,55); pdf.rect(44,20,15,.8,"F");
    const nomeProcesso = document.querySelector('#tipo-processo-portugues option:checked')?.textContent || "";
    pdf.setFont("helvetica","normal"); pdf.setFontSize(10); pdf.text("Cidadania Portuguesa — " + nomeProcesso,14,29);
    const dadosProcesso = coletarCamposPortugal(document.getElementById("campos-processo-portugues"));
    if (dadosProcesso.length) {
      pdf.autoTable({ startY:yPt, head:[], body:dadosProcesso, theme:"plain", styles:{font:"helvetica",fontSize:9.5,cellPadding:3.2,overflow:"linebreak",textColor:[60,65,75],valign:"top"}, columnStyles:{0:{cellWidth:65,fontStyle:"bold",textColor:[100,110,120]},1:{cellWidth:"auto"}}, margin:{left:14,right:14,bottom:18} });
      yPt = pdf.lastAutoTable.finalY + 10;
    }
    document.querySelectorAll("#lista-documentos-portugueses .portugal-doc-card").forEach((c, index) => {
      if (yPt > 255) { pdf.addPage(); yPt = 20; }
      pdf.setFont("helvetica","bold"); pdf.setFontSize(11); pdf.setTextColor(17,24,37);
      pdf.text("Documento " + (index+1) + ": " + (c.querySelector(".pt-documento-nome")?.value.trim() || "Não informado"),14,yPt);
      yPt += 4;
      const camposDoc = coletarCamposPortugal(c).filter(row => !["Nome do documento"].includes(row[0]));
      if (camposDoc.length) {
        pdf.autoTable({ startY:yPt, head:[], body:camposDoc, theme:"plain", styles:{font:"helvetica",fontSize:9.5,cellPadding:3.2,overflow:"linebreak",textColor:[60,65,75],valign:"top"}, columnStyles:{0:{cellWidth:65,fontStyle:"bold",textColor:[100,110,120]},1:{cellWidth:"auto"}}, margin:{left:14,right:14,bottom:18} });
        yPt = pdf.lastAutoTable.finalY + 3;
      }
      yPt = adicionarDivergenciasDocumentoPDF(pdf,c,14) + 4;
      const obs = c.querySelector(".pt-documento-observacoes")?.value.trim();
      if (obs) { pdf.autoTable({startY:yPt,head:[],body:[["Observações",obs]],theme:"plain",styles:{font:"helvetica",fontSize:9.5,cellPadding:3.2,overflow:"linebreak"},margin:{left:14,right:14,bottom:18}}); yPt=pdf.lastAutoTable.finalY+8; }
    });
    pdf.save("analise-cidadania-portuguesa.pdf");
    return;
  }

  function garantirEspaco(altura) {
    if (y + altura > 280) {
      pdf.addPage();
      y = 20;
    }
  }

  pdf.setTextColor(17, 24, 37);
  pdf.setFontSize(14);
  pdf.setFont("helvetica", "bold");
  pdf.text("EXTRATO DA REVISÃO DO PROCESSO DE CIDADANIA", 14, 16);
  pdf.setFillColor(17, 24, 37); pdf.rect(14, 20, 15, 0.8, 'F');
  pdf.setFillColor(221, 0, 0); pdf.rect(29, 20, 15, 0.8, 'F');
  pdf.setFillColor(212, 175, 55); pdf.rect(44, 20, 15, 0.8, 'F');
  let y = 36;

  document.querySelectorAll("#geracoes .card").forEach((c) => {
    const numeroGeracao = Number(c.dataset.geracao) || 1;
    const subGeracao = c.dataset.subgeracao || "";
    const parentescoTexto = c.dataset.parentesco || parentesco[numeroGeracao] || "Descendente";
    const nome = c.querySelector(".nome").value.trim() || "Nome não informado";
    const nasc = c.querySelector(".nasc").value.trim() || "-";
    const paisNascimento = c.querySelector(".nasc-pais").value.trim() || "-";
    const estadoNascimento = c.querySelector(".nasc-estado").value.trim() || "-";
    const cidadeNascimento = c.querySelector(".nasc-cidade").value.trim() || "-";
    const statusCasamento = c.querySelector(".casamento-status").value;
    const casou = statusCasamento === "casado";
    const dataCasamento = casou ? (c.querySelector(".casamento-data").value.trim() || "-") : "-";
    const conjuge = casou ? (c.querySelector(".conjuge-nome").value.trim() || "-") : "-";
    const ehRequerente = c.querySelector(".is-requerente").checked;
    let statusTexto = statusCasamento === "casado" ? `Casado(a) em ${dataCasamento}` : statusCasamento === "divorciado" ? "Divorciado(a)" : "Solteiro(a)";
    const dadosFicha = [
      ["Data de Nascimento", nasc],
      ["Local de Nascimento", `${cidadeNascimento} - ${estadoNascimento} - ${paisNascimento}`],
      ["Status de Casamento", statusTexto]
    ];
    if (casou) dadosFicha.push(["Nome do Cônjuge", conjuge]);
    if (
      tipoCidadania === "portuguesa" &&
      processosGenealogicosPortugal.includes(processoPortugal) &&
      numeroGeracao === 1
    ) {
      dadosFicha.push([
        "Artigo pelo qual o ascendente originário foi reconhecido português",
        c.querySelector(".artigo-reconhecimento")?.value.trim() || "-"
      ]);
    }
    if (casou && tipoCidadania === "portuguesa" && processoPortugal === "casamento") {
      dadosFicha.push(["Tempo de casados (anos)", c.querySelector(".tempo-casados")?.value.trim() || "-"]);
      dadosFicha.push(["Profissão do cônjuge", c.querySelector(".profissao-conjuge")?.value.trim() || "-"]);
    }
    dadosFicha.push(["É Requerente do Processo?", ehRequerente ? "Sim" : "Não"]);
    if (ehRequerente) {
      if (tipoCidadania === "portuguesa" && processosComResidenciaPortugal.includes(processoPortugal)) {
        const respostaResidencia = c.querySelector(".residiu-fora:checked")?.value;
        if (respostaResidencia) dadosFicha.push(["O requerente já residiu fora do Brasil?", respostaResidencia]);
        const paisResidencia = c.querySelector(".pais-residencia-valor")?.value.trim();
        if (respostaResidencia === "Sim" && paisResidencia) dadosFicha.push(["País em que residiu", paisResidencia]);
      }
      if (tipoCidadania === "portuguesa") dadosFicha.push(["Idade do Requerente", c.querySelector(".idade-requerente-valor")?.value.trim() || "-"]);
      dadosFicha.push(["Tipo de Documento", c.querySelector(".doc-tipo").value]);
      dadosFicha.push(["Número do Documento", c.querySelector(".doc-num").value.trim() || "-"]);
      dadosFicha.push(["Validade do Documento", c.querySelector(".doc-validade").value.trim() || "-"]);
      const representante = c.querySelector(".dados-representante-menor");
      if (representante && !representante.classList.contains("hidden")) {
        dadosFicha.push(["Nome do pai/mãe ou representante legal", representante.querySelector(".representante-nome")?.value.trim() || "-"]);
        dadosFicha.push(["Tipo de documento do representante", representante.querySelector(".representante-doc-tipo")?.value || "-"]);
        dadosFicha.push(["Número do documento do representante", representante.querySelector(".representante-doc-num")?.value.trim() || "-"]);
        dadosFicha.push(["Validade do documento do representante", representante.querySelector(".representante-doc-validade")?.value || "-"]);
      }
    }

    // Cada pessoa começa com um título e uma ficha; o AutoTable controla quebras de página.
    const identificacaoGeracao = subGeracao ? `${numeroGeracao}.${subGeracao}` : `${numeroGeracao}`;
    let tituloTexto = `Geração ${identificacaoGeracao} - ${parentescoTexto}: ${nome}`;
    if (ehRequerente) tituloTexto += " [REQUERENTE DO PROCESSO]";
    pdf.setFont("helvetica", "bold");
    pdf.setFontSize(11);
    const linhasTitulo = pdf.splitTextToSize(tituloTexto, larguraUtil);
    const alturaTitulo = linhasTitulo.length * 5 + 5;
    garantirEspaco(alturaTitulo + 20);
    pdf.setTextColor(17, 24, 37);
    pdf.text(linhasTitulo, margemEsquerda, y);
    const linhaY = y + linhasTitulo.length * 5 + 1;
    pdf.setDrawColor(220, 225, 230);
    pdf.setLineWidth(0.3);
    pdf.line(margemEsquerda, linhaY, 196, linhaY);

    pdf.autoTable({
      startY: linhaY + 2,
      head: [],
      body: dadosFicha,
      theme: "plain",
      styles: { font: "helvetica", fontSize: 9.5, cellPadding: 3.2, overflow: "linebreak", textColor: [60,65,75], valign: "top" },
      columnStyles: {
        0: { cellWidth: 55, fontStyle: "bold", textColor: [100,110,120] },
        1: { cellWidth: "auto" }
      },
      margin: { left: margemEsquerda, right: 14, bottom: 18 },
      didParseCell: function(data) {
        data.cell.styles.lineWidth = { bottom: 0.1 };
        data.cell.styles.lineColor = [230,235,240];
      }
    });
    y = pdf.lastAutoTable.finalY + 8;

    // Seção de divergências documentais no PDF.
    const statusDivergencia = c.querySelector(".divergencia-status:checked")?.value || "nao";
    garantirEspaco(18);
    pdf.setFont("helvetica", "bold");
    pdf.setFontSize(10);
    pdf.setTextColor(17, 24, 37);
    pdf.text("Análise Documental – Divergências Identificadas", margemEsquerda, y);
    y += 6;

    if (statusDivergencia === "nao") {
      pdf.setFont("helvetica", "normal");
      pdf.setFontSize(9.5);
      pdf.setTextColor(60, 65, 75);
      pdf.text("Não foram identificadas divergências documentais.", margemEsquerda, y);
      y += 7;
    } else {
      const divergencias = Array.from(c.querySelectorAll(".divergencia-item"));
      if (divergencias.length === 0) {
        garantirEspaco(12);
        pdf.setFont("helvetica", "normal");
        pdf.setFontSize(9.5);
        pdf.text("Foram identificadas divergências, mas nenhum detalhe foi preenchido.", margemEsquerda, y);
        y += 7;
      } else {
        divergencias.forEach((item, index) => {
          const documento = item.querySelector(".divergencia-documento").value.trim() || "Não informado";
          const consta = item.querySelector(".divergencia-consta").value.trim() || "Não informado";
          const deveria = item.querySelector(".divergencia-deveria").value.trim() || "Não informado";
          const tabelaDivergencia = [
            [`Divergência ${index + 1} — Documento`, documento],
            ["Como consta no documento", consta],
            ["Como deveria constar", deveria]
          ];
          // A tabela pode continuar em outra página sem cortar texto nem perder as etiquetas.
          pdf.autoTable({
            startY: y,
            head: [],
            body: tabelaDivergencia,
            theme: "grid",
            styles: { font: "helvetica", fontSize: 9, cellPadding: 3.2, overflow: "linebreak", textColor: [60,65,75], lineColor: [225,230,235], lineWidth: 0.2, valign: "top" },
            columnStyles: {
              0: { cellWidth: 55, fontStyle: "bold", fillColor: [248,249,250], textColor: [80,90,100] },
              1: { cellWidth: "auto" }
            },
            margin: { left: margemEsquerda, right: 14, bottom: 18 },
            pageBreak: "auto",
            rowPageBreak: "avoid"
          });
          y = pdf.lastAutoTable.finalY + 4;
        });
        y += 2;
      }
    }
    y += 8;
  });

  if (tipoCidadania === "portuguesa") {
    pdf.save("analise-cidadania-portuguesa.pdf");
  } else {
    pdf.save("analise-cidadania-alema.pdf");
  }
}

// Inicia o formulário com a primeira pessoa/geração.
// A cidadania só é carregada depois da seleção inicial.

</script>
</body>
</html>
